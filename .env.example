# --- GitHub ---
# Fine-grained PAT with Contents: read/write and Pull requests: read/write on the target repo(s)
GITHUB_TOKEN=

# --- HTTP ---
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Storage ---
DATABASE_PATH=./data/app.db
WORKSPACE_DIR=./workspaces
KEEP_FAILED_WORKSPACES=true

# --- Coverage ---
COVERAGE_THRESHOLD=80
COVERAGE_SOURCE_GLOB=src/**/*.ts

# --- Worker ---
RUN_WORKER=true
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=2000
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=2
PROCESS_TIMEOUT_MS=600000

# --- AI (Claude Code headless) ---
AI_CLI_PATH=claude
AI_MODE=plan-and-write          # single | plan-and-write
AI_PLANNER_MODEL=opus
AI_WRITER_MODEL=sonnet
AI_PLANNER_MAX_TURNS=10
AI_WRITER_MAX_TURNS=30
AI_MAX_BUDGET_USD=3
AI_TIMEOUT_MS=600000
AI_MAX_FIX_ATTEMPTS=2
